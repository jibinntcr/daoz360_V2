{
  "name": "daoz360",
  "version": "2.0.0",
  "private": true,
  "description": "DAOZ360 — Multi-Tenant Social Media Management, Publishing, Approvals & Analytics Platform (Next.js App Router + Node.js Worker + MongoDB)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/worker/index.ts",
    "worker:once": "tsx src/worker/index.ts --once",
    "db:setup": "tsx src/scripts/setup-db.ts",
    "db:migrate-legacy": "tsx src/scripts/migrate-legacy.ts",
    "test": "tsx src/tests/daoz360.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "lucide-react": "^0.460.0",
    "mongodb": "^6.11.0",
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.4.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
