APP_BASE_URL=http://localhost:3000
CANONICAL_HOST=https://daoz360.ai
NODE_ENV=development
DAOZ360_PRICING_MODE=quote

MONGODB_URI=mongodb://127.0.0.1:27017/daoz360?replicaSet=rs0
