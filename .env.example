AUTH_SECRET=replace_with_32_byte_hex_session_signing_secret_00000000000000
GRANT_ENCRYPTION_KEY_ID=v1
GRANT_ENCRYPTION_KEY_V1=replace_with_64_hex_char_aes256_gcm_master_key_0000000000000000
GRANT_ENCRYPTION_KEY_PREVIOUS=
ADMIN_BOOTSTRAP_EMAIL=admin@daoz360.ai
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeImmediately!2026
ADMIN_BOOTSTRAP_MFA_SECRET=JBSWY3DPEHPK3PXP

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=daoz360-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

META_FACEBOOK_APP_ID=
META_FACEBOOK_APP_SECRET=
